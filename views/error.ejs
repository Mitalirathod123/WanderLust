<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Error</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <div class="container mt-5">

        <div class="row">

            <div class="alert alert-danger col-6 offset-3"
                role="alert">

                <h4 class="alert-heading">
                    <%= statusCode %>
                </h4>

                <p>
                    <%= message %>
                </p>

                <hr>

                <a href="/listings"
                    class="btn btn-dark">
                    Back to Listings
                </a>

            </div>

        </div>

    </div>

</body>

</html>