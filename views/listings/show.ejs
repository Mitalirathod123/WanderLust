<% layout("/layouts/boilerplate") -%>

    <div class="row mt-4">

        <!-- ================= LISTING TITLE ================= -->

        <div class="col-12">
            <h3 class="show-title">Listing Details</h3>
        </div>


        <!-- ================= LISTING DETAILS ================= -->

        <div class="col-md-8 offset-md-2">

            <div class="show-card">

                <img src="<%= listing.image.url %>" class="show-img" alt="listing_image"
                    onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6'">

                <div class="show-card-body">

                    <h3 class="show-listing-title">
                        <%= listing.title %>
                    </h3>

                    <p class="show-description">
                        <%= listing.description %>
                    </p>

                    <p class="show-price">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                            <span>/ night</span>
                    </p>

                    <p class="show-location">
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>, <%= listing.country %>
                    </p>

                </div>

            </div>


            <!-- ================= EDIT & DELETE BUTTONS ================= -->

            <% if ( currentUser && listing.owner && listing.owner.equals(currentUser._id) ) { %>

                <div class="btns">

                    <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
                        Edit
                    </a>


                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">

                        <button class="btn delete-btn" type="submit">
                            Delete
                        </button>

                    </form>

                </div>

                <% } %>


                    <!-- ================= REVIEW SECTION ================= -->

                    <hr class="mt-5">

                    <% let averageRating=0; if (listing.reviews.length> 0) {

                        const totalRating =
                        listing.reviews.reduce(
                        (sum, review) => sum + review.rating,
                        0
                        );

                        averageRating =
                        totalRating / listing.reviews.length;
                        }
                        %>

                        <div class="d-flex align-items-center mb-4">

                            <h4 class="mb-0 me-3">
                                Customer Reviews
                            </h4>

                            <% if (listing.reviews.length> 0) { %>

                                <span class="text-muted">
                                    ⭐ <%= averageRating.toFixed(1) %> / 5
                                        (<%= listing.reviews.length %> reviews)
                                </span>

                                <% } %>

                        </div>


                        <!-- REVIEW FORM -->

                        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mb-5">

                            <!-- RATING -->

                            <div class="mb-3">

                                <label for="rating" class="form-label">
                                    Rating
                                </label>

                                <select name="review[rating]" id="rating" class="form-select" required>

                                    <option value="">
                                        Select rating
                                    </option>

                                    <option value="1">
                                        ⭐ 1 - Poor
                                    </option>

                                    <option value="2">
                                        ⭐⭐ 2 - Fair
                                    </option>

                                    <option value="3">
                                        ⭐⭐⭐ 3 - Good
                                    </option>

                                    <option value="4">
                                        ⭐⭐⭐⭐ 4 - Very Good
                                    </option>

                                    <option value="5">
                                        ⭐⭐⭐⭐⭐ 5 - Excellent
                                    </option>

                                </select>

                            </div>


                            <!-- COMMENT -->

                            <div class="mb-3">

                                <label for="comment" class="form-label">
                                    Comment
                                </label>

                                <textarea name="review[comment]" id="comment" class="form-control" rows="4"
                                    placeholder="Write your review..." required></textarea>

                            </div>


                            <!-- SUBMIT BUTTON -->

                            <button type="submit" class="btn btn-dark">
                                Submit Review
                            </button>

                        </form>
                        <hr class="mt-5">

                        <% if (listing.reviews.length===0) { %>

                            <p class="text-muted">
                                No reviews yet. Be the first to review this listing!
                            </p>

                            <% } else { %>

                                <div class="row">

                                    <% for (let review of listing.reviews) { %>

                                        <div class="col-md-6 mb-3">

                                            <div class="card p-3">

                                                <h6 class="mb-2">
                                                    <i class="fa-solid fa-user"></i>
                                                    <%= review.author ? review.author.username : "Anonymous" %>
                                                </h6>

                                                <h5>
                                                    <%= "⭐" .repeat(review.rating) %>
                                                </h5>

                                                <p class="mb-3">
                                                    <%= review.comment %>
                                                </p>

                                                <% if ( currentUser && review.author &&
                                                    review.author._id.equals(currentUser._id) ) { %>

                                                    <form method="POST"
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            Delete Review
                                                        </button>
                                                    </form>

                                                    <% } %>

                                            </div>

                                        </div>

                                        <% } %>

                                </div>

                                <% } %>